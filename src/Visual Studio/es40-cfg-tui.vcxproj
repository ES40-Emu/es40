  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- The editor ships in every solution configuration, so its feature set is derived
       from the configuration name instead of duplicating 27 property groups. -->
  <PropertyGroup Label="ES40Configuration">
    <Es40IsDebug>false</Es40IsDebug>
    <Es40IsDebug Condition="$(Configuration.StartsWith('Debug'))">true</Es40IsDebug>
    <Es40Sse2>false</Es40Sse2>
    <Es40Sse2 Condition="$(Configuration.Contains('- SSE2'))">true</Es40Sse2>
    <Es40NoNetwork>false</Es40NoNetwork>
    <Es40NoNetwork Condition="$(Configuration.Contains(' NN'))">true</Es40NoNetwork>
    <Es40NoScreen>false</Es40NoScreen>
    <Es40NoScreen Condition="$(Configuration.Contains(' NS'))">true</Es40NoScreen>
    <Es40Jit>false</Es40Jit>
    <Es40Jit Condition="$(Configuration.Contains('JIT'))">true</Es40Jit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Es40IsDebug)'=='true'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Es40IsDebug)'!='true'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(SolutionDir)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <LinkIncremental>$(Es40IsDebug)</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <!-- _HAS_STD_BYTE=0: the TUI's "using namespace std" makes std::byte clash with the SDK's byte. -->
      <PreprocessorDefinitions>WIN32;_CONSOLE;CONFIGURATION_ONLY;_HAS_STD_BYTE=0;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>..;..\..\third_party\PDCursesMod;..\..\third_party\netbsd-curses\libform;..\..\third_party\netbsd-curses\libmenu;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>winmm.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <!-- Feature defines track the emulator configuration the editor ships beside. -->
  <ItemDefinitionGroup Condition="'$(Es40NoNetwork)'!='true'">
    <ClCompile>
      <PreprocessorDefinitions>HAVE_PCAP;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>c:\dev\npcap-sdk\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>wpcap.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>c:\dev\npcap-sdk\lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Delay-loaded so the editor starts without Npcap; only adapter listing needs wpcap.dll. -->
      <DelayLoadDLLs>wpcap.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Es40NoScreen)'!='true'">
    <ClCompile>
      <PreprocessorDefinitions>HAVE_SDL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Es40Jit)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>ES40_JIT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- ISA follows the configuration, like es40.vcxproj: AVX2 by default, SSE2 in "- SSE2". -->
  <ItemDefinitionGroup Condition="'$(Es40Sse2)'!='true'">
    <ClCompile>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Es40Sse2)'=='true'">
    <ClCompile>
      <EnableEnhancedInstructionSet>StreamingSIMDExtensions2</EnableEnhancedInstructionSet>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Es40IsDebug)'=='true'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Es40IsDebug)'!='true'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
